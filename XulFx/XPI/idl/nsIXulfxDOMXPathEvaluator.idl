	readonly attribute unsigned short   resultType;
	readonly attribute double           numberValue;
	readonly attribute DOMString        stringValue;
	readonly attribute boolean          booleanValue;
	readonly attribute nsIDOMNode       singleNodeValue;
	readonly attribute boolean          invalidIteratorState;
	readonly attribute unsigned long    snapshotLength;
	nsIDOMNode iterateNext() raises(XPathException, DOMException);
	nsIDOMNode snapshotItem(in unsigned long index) raises(XPathException);
};

[scriptable, uuid(d2435f89-6709-4e00-b0b6-31ceae45c192)]
interface nsIXulfxDOMXPathEvaluator : nsISupports
{
	void init(in nsIDOMDocument aDocument);
	nsISupports createNSResolver(in nsIDOMNode aNode);
	nsISupports createResolver(in DOMString aFnSource);
	nsIXulfxDOMXPathResult evaluate(in DOMString expression, in nsIDOMNode contextNode, in nsISupports resolver, in unsigned short type);
};